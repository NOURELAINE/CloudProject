# Configuration de l'API EMSI Notes
# Copier ce fichier vers /etc/emsi-notes/emsi-notes.env puis le protéger :
#   sudo chmod 600 /etc/emsi-notes/emsi-notes.env
# Ce fichier contient des secrets : il ne doit jamais être publié.

# --- Base de données ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=emsi_notes
DB_USER=emsi_app
DB_PASSWORD=A_REMPLACER

# --- Sécurité -----------------------------------------------------------
# Clé de signature des jetons : une longue chaîne aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=A_REMPLACER

# --- Modes pédagogiques (TP) --------------------------------------------
# 1 = la recherche de l'annuaire est vulnérable à l'injection SQL
MODE_VULNERABLE=1
# 1 = les erreurs détaillées (traces Python) sont renvoyées au navigateur
MODE_DEBUG=0
